{
    // ssh
    "remote.SSH.remotePlatform": {
        "192.168.2.149": "linux"
    },

    // vim
    "vim.easymotion": true,
    "vim.incsearch": true,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.hlsearch": true,
    "vim.leader": "<space>",
    "vim.handleKeys": {
        "<C-p>": false,
        "<C-a>": true,
        "<C-f>": true,
        "<C-b>": true,
        "<C-d>": true,
        "<C-u>": true,
    },
    "vim.insertModeKeyBindingsNonRecursive": [
        {
            "before": [ "j", "k" ],
            "after": [ "<Esc>" ]
        }
    ],
    "vim.commandLineModeKeyBindingsNonRecursive": [
        {
            "before": [ "j", "k" ],
            "after": [ "<cr>" ]
        },
        {
            "before": [ "j", "j" ],
            "after": [ "<C-c>" ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["y", "h"],
            "after": ["y", "^"]
        },
        {
            "before": ["y", "l"],
            "after": ["y", "$"]
        },
        {
            "before": ["c", "h"],
            "after": ["c", "^"]
        },
        {
            "before": ["c", "l"],
            "after": ["C"]
        },
        {
            "before": ["d", "h"],
            "after": ["d", "^"]
        },
        {
            "before": ["d", "l"],
            "after": ["D"]
        },
        {
            "before": ["<leader>", "w", "h"],
            "commands": [":split"]
        },
        {
            "before": ["<leader>", "w", "v"],
            "commands": [":vsplit"]
        },
        {
            "before": ["<leader>", "w", "d"],
            "commands" : [":close"],
        },
        {
            "before": ["<leader>", "f", "b"],
            "commands": [":ls"]
        },
        {
            "before": ["<leader>", "f", "f"],
            "commands": ["workbench.action.quickOpen"]
        },
        {
            "before": ["<leader>", "f", "g"],
            "commands": ["workbench.view.search"],
        },
        {
            "before": [ "<leader>", "s" ],
            "commands": [ ":w" ]
        },
        {
            "before": [ "<leader>", "q" ],
            "commands": [ ":q" ]
        },
        {
            "before": [ "<leader>", "n", "h" ],
            "commands": [ ":nohl" ]
        },
        {
            "before": [ "<enter>" ],
            "after": [ "i", "<cr>", "<esc>" ]
        },
        {
            "before": [ "g", "h" ],
            "after": [ "^" ]
        },
        {
            "before": [ "g", "l" ],
            "after": [ "$" ]
        },
        {
            "before": [ "g", "m" ],
            "after": [ "%" ]
        },
        {
            "before": ["K"],  
            "commands": [ "editor.action.showHover"]
        },
        {
            "before": ["g", "r"],
            "commands": ["editor.action.goToReferences"],
        },
        {
            "before": ["g", "j"],
            "commands": ["editor.action.revealDefinition"]
        },
        {
            "before": ["g", "k"],
            "commands": ["workbench.action.navigateBack"],
        },
        {
            "before": ["leader", "e"],
            "commands": ["workbench.explorer.fileView.focus"],
        },
        {
            "before": ["leader", "c", "p"], 
            "commands": ["editor.action.marker.prevInFiles"],
        },
        {
            "before": ["leader", "c", "n"],
            "commands": ["editor.action.marker.nextInFiles"],
        },
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [ "g", "h" ],
            "after": [ "^" ]
        },
        {
            "before": [ "g", "l" ],
            "after": [ "$", "h" ]
        },
        {
            "before": [ "g", "m" ],
            "after": [ "%" ]
        },
        {
            "before": [ "<tab>" ],
            "after": [ ":", "n", "o", "r", "m", " ", "@", "a", "<cr>" ]
        }
    ],

    // extension
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1,
    },
    "extensions.ignoreRecommendations": true,

    // editor
    "editor.lineNumbers":"relative",
    "editor.smoothScrolling": true,
    "editor.cursorBlinking": "smooth",
    "editor.fontFamily": "LXGW WenKai Mono",
    "editor.fontSize": 15,
    "editor.fontWeight": "normal",
    "editor.tokenColorCustomizations": {
        "[Tokyo Night]": { // or "[Tokyo Night Storm]"
            "textMateRules": [{
                "scope": [
                    "comment",
                    "storage.modifier"
                ],
                "settings": {
                    "fontStyle": ""
                }
            }]
        }
    },
    "editor.renderLineHighlight": "none",
    "editor.bracketPairColorization.enabled": false,
    "editor.renderWhitespace": "none",
    "editor.minimap.renderCharacters": false,
    "editor.guides.indentation": true,

    // other
    "problems.visibility": false,
    "markdown-preview-enhanced.previewTheme": "atom-dark.css",
    "workbench.productIconTheme": "icons-carbon",
    // "window.zoomLevel": 0.5,
    "catppuccin.accentColor": "lavender",
    "catppuccin.italicComments": false,
    "catppuccin.italicKeywords": false,
    // "workbench.iconTheme": "catppuccin-mocha",
    "everforest.darkContrast": "hard",
    "workbench.iconTheme": "quill-icons",
    "workbench.colorTheme": "Moonlight"
}
